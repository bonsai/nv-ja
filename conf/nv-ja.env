# nv-ja defaults (Config > code)
#
# 日本語 STT/TTS はこの 2 本のみ（他は ja 非対応。実測は SKILL.md 参照）
NV_ASR_FUNC_NAME="${NV_ASR_FUNC_NAME:-ai-whisper-large-v3}"
NV_TTS_FUNC_NAME="${NV_TTS_FUNC_NAME:-ai-magpie-tts-multilingual}"

NV_ASR_LANG="${NV_ASR_LANG:-ja}"        # whisper は ja / ja-JP どちらも可
NV_TTS_LANG="${NV_TTS_LANG:-ja-JP}"
NV_TTS_VOICE="${NV_TTS_VOICE:-}"        # 空 = NIM の既定声（ja のサブボイス名は未確定）

NV_GRPC="${NV_GRPC:-grpc.nvcf.nvidia.com:443}"
NV_ASR_SR="${NV_ASR_SR:-16000}"
NV_TTS_SR="${NV_TTS_SR:-22050}"
NV_KEY_ENV="${NV_KEY_ENV:-NVIDIA_API_KEY}"
NV_RETRY="${NV_RETRY:-3}"               # 無料枠の rate limit 用リトライ回数
NV_FUNC_CACHE_DAYS="${NV_FUNC_CACHE_DAYS:-7}"

NV_VENV="${NV_VENV:-$SKILL_DIR/.venv}"  # nvidia-riva-client 用（初回に自動構築）
NV_STATE_DIR="${NV_STATE_DIR:-$SKILL_DIR/state}"
